# Public API. The application itself remains bound to loopback.
pulso-transmi.72-60-245-2.sslip.io {
	encode zstd gzip

	@submissions {
		method POST
		path /v1/submissions
	}
	handle @submissions {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8010
	}

	@public path / /assets/* /health /ready /docs /docs/* /openapi.json /v1/*
	handle @public {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		respond "Not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output file /var/log/caddy/pulso-transmi.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
